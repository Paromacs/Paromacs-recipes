<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>
        Downloads the latest Yealink USB Connect macOS package
        for the selected architecture.
    </string>

    <key>Identifier</key>
    <string>com.github.paromacs.download.YealinkUSBConnect</string>

    <key>Input</key>
    <dict>
        <key>ARCH</key>
        <string>arm64</string>
    </dict>

    <key>MinimumVersion</key>
    <string>2.3</string>

    <key>Process</key>
    <array>
        <dict>
            <key>Processor</key>
            <string>YealinkUSBConnectURLProvider</string>
            <key>Arguments</key>
            <dict>
                <key>ARCH</key>
                <string>%ARCH%</string>
            </dict>
        </dict>

        <dict>
            <key>Processor</key>
            <string>URLDownloader</string>
            <key>Arguments</key>
            <dict>
                <key>url</key>
                <string>%url%</string>
                <key>filename</key>
                <string>%filename%</string>
            </dict>
        </dict>

        <dict>
            <key>Processor</key>
            <string>EndOfCheckPhase</string>
        </dict>
    </array>
</dict>
</plist>