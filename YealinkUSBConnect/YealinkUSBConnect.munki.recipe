<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Import Yealink USB Connect for macOS, preserving separate arm64 and x86_64 pkginfo filenames.</string>

    <key>Identifier</key>
    <string>com.github.paromacs.munki.YealinkUSBConnect</string>

    <key>ParentRecipe</key>
    <string>com.github.paromacs.download.YealinkUSBConnect</string>

    <key>Input</key>
    <dict>
        <key>NAME</key>
        <string>YealinkUSBConnect</string>

        <key>ARCH</key>
        <string>arm64</string>

        <key>MUNKI_REPO_SUBDIR</key>
        <string>apps/Yealink</string>

        <key>pkginfo</key>
        <dict>
            <key>name</key>
            <string>YealinkUSBConnect</string>

            <key>display_name</key>
            <string>Yealink USB Connect</string>

            <key>category</key>
            <string>Utilities</string>

            <key>developer</key>
            <string>Yealink</string>

            <key>supported_architectures</key>
            <array>
                <string>%ARCH%</string>
            </array>

            <key>unattended_install</key>
            <true/>

            <key>unattended_uninstall</key>
            <true/>

            <key>autoremove</key>
            <false/>

            <key>uninstallable</key>
            <true/>

            <key>catalogs</key>
            <array>
                <string>testing</string>
            </array>
        </dict>
    </dict>

    <key>MinimumVersion</key>
    <string>2.7</string>

    <key>Process</key>
    <array>
        <dict>
            <key>Processor</key>
            <string>YealinkMunkiArchPkginfo</string>
            <key>Arguments</key>
            <dict>
                <key>ACTION</key>
                <string>preflight</string>
                <key>MUNKI_REPO</key>
                <string>%MUNKI_REPO%</string>
                <key>repo_subdirectory</key>
                <string>%MUNKI_REPO_SUBDIR%</string>
                <key>version</key>
                <string>%version%</string>
                <key>munki_arch</key>
                <string>%ARCH%</string>
            </dict>
        </dict>

        <dict>
            <key>Processor</key>
            <string>YealinkMunkiVersion</string>
            <key>Arguments</key>
            <dict>
                <key>version</key>
                <string>%version%</string>
            </dict>
        </dict>

        <dict>
            <key>Processor</key>
            <string>MunkiImporter</string>
            <key>Arguments</key>
            <dict>
                <key>pkg_path</key>
                <string>%pathname%</string>
                <key>repo_subdirectory</key>
                <string>%MUNKI_REPO_SUBDIR%</string>
            </dict>
        </dict>

        <dict>
            <key>Processor</key>
            <string>YealinkMunkiArchPkginfo</string>
            <key>Arguments</key>
            <dict>
                <key>ACTION</key>
                <string>finalize</string>
                <key>MUNKI_REPO</key>
                <string>%MUNKI_REPO%</string>
                <key>repo_subdirectory</key>
                <string>%MUNKI_REPO_SUBDIR%</string>
                <key>version</key>
                <string>%version%</string>
                <key>munki_arch</key>
                <string>%ARCH%</string>
            </dict>
        </dict>
    </array>
</dict>
</plist>
