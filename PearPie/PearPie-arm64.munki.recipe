<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Import the latest PearPie beta for Apple Silicon into Munki.</string>
	<key>Identifier</key>
	<string>local.munki.PearPie-arm64</string>
	<key>ParentRecipe</key>
	<string>local.download.PearPie-arm64</string>
	<key>Input</key>
	<dict>
		<key>NAME</key>
		<string>PearPie</string>
		<key>MUNKI_REPO_SUBDIR</key>
		<string>apps/PearPie</string>
		<key>pkginfo</key>
		<dict>
			<key>name</key>
			<string>%NAME%</string>
			<key>display_name</key>
			<string>PearPie</string>
			<key>description</key>
			<string>PearPie desktop application (beta) for Apple Silicon.</string>
			<key>catalogs</key>
			<array>
				<string>testing</string>
			</array>
			<key>supported_architectures</key>
			<array>
				<string>arm64</string>
			</array>
			<key>minimum_os_version</key>
			<string>13.0</string>
            <key>developer</key>
            <string>PearPie B.V.</string>
            <key>unattended_install</key>
            <true/>
			<key>uninstallable</key>
			<true/>
			<key>uninstall_method</key>
			<string>remove_copied_items</string>
			<key>blocking_applications</key>
			<array>
				<string>PearPie.app</string>
			</array>
		</dict>
	</dict>
	<key>MinimumVersion</key>
	<string>2.7</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Processor</key>
			<string>MunkiImporter</string>
			<key>Arguments</key>
			<dict>
				<key>pkg_path</key>
				<string>%pathname%</string>
				<key>repo_subdirectory</key>
				<string>%MUNKI_REPO_SUBDIR%</string>
				<key>version_comparison_key</key>
				<string>CFBundleShortVersionString</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
