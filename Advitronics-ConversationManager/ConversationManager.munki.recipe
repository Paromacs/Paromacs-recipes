<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Imports Advitronics Conversation Manager into Munki with separate pkginfo files for arm64 and x86_64.</string>
	<key>Identifier</key>
	<string>com.github.paromacs.munki.ConversationManager</string>
	<key>ParentRecipe</key>
	<string>com.github.paromacs.download.ConversationManager</string>
	<key>Input</key>
	<dict>
		<key>NAME</key>
		<string>ConversationManager</string>
		<key>ARCH</key>
		<string>arm64</string>
		<key>MUNKI_REPO_SUBDIR</key>
		<string>apps/Advitronics</string>
		<key>pkginfo</key>
		<dict>
			<key>catalogs</key>
			<array>
				<string>testing</string>
			</array>
			<key>name</key>
			<string>ConversationManager</string>
			<key>display_name</key>
			<string>Advitronics Conversation Manager</string>
			<key>category</key>
			<string>Communication</string>
			<key>developer</key>
			<string>Advitronics</string>
			<key>unattended_install</key>
			<true/>
			<key>unattended_uninstall</key>
			<false/>
		</dict>
	</dict>
	<key>MinimumVersion</key>
	<string>2.7</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Processor</key>
			<string>AdvitronicsConversationManagerMunkiProcessor</string>
			<key>Arguments</key>
			<dict>
				<key>ACTION</key>
				<string>preflight</string>
				<key>repo_subdirectory</key>
				<string>%MUNKI_REPO_SUBDIR%</string>
			</dict>
		</dict>
		<dict>
			<key>Processor</key>
			<string>AdvitronicsConversationManagerMunkiProcessor</string>
			<key>Arguments</key>
			<dict>
				<key>ACTION</key>
				<string>prepare</string>
			</dict>
		</dict>
		<dict>
			<key>Processor</key>
			<string>MunkiImporter</string>
			<key>Arguments</key>
			<dict>
				<key>pkg_path</key>
				<string>%pathname%</string>
				<key>repo_subdirectory</key>
				<string>%MUNKI_REPO_SUBDIR%</string>
			</dict>
		</dict>
		<dict>
			<key>Processor</key>
			<string>AdvitronicsConversationManagerMunkiProcessor</string>
			<key>Arguments</key>
			<dict>
				<key>ACTION</key>
				<string>finalize</string>
				<key>repo_subdirectory</key>
				<string>%MUNKI_REPO_SUBDIR%</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
