<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Upload the verified PearPie Windows x64 MSI to the existing Action1 PearPie package.</string>
	<key>Identifier</key>
	<string>com.github.paromacs.action1.PearPie-Win</string>
	<key>Input</key>
	<dict>
		<key>ACTION1_BASE_URL</key>
		<string>https://app.eu.action1.com/api/3.0</string>
		<key>ACTION1_CLIENT_ID</key>
		<string>CHANGE_ME</string>
		<key>ACTION1_CLIENT_SECRET</key>
		<string>CHANGE_ME</string>
		<key>ACTION1_DRY_RUN</key>
		<string>true</string>
		<key>ACTION1_ORG_ID</key>
		<string>CHANGE_ME</string>
		<key>ACTION1_PACKAGE_NAME</key>
		<string>PearPie</string>
		<key>NAME</key>
		<string>PearPie-Win</string>
		<key>PEARPIE_RELEASE_URL</key>
		<string>https://releases.pearpie.ai/beta/latest-win-x64-msi.json</string>
	</dict>
	<key>MinimumVersion</key>
	<string>2.7</string>
	<key>ParentRecipe</key>
	<string>com.github.paromacs.download.PearPie-Win</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Processor</key>
			<string>Action1PearPieUpload</string>
		</dict>
	</array>
</dict>
</plist>
