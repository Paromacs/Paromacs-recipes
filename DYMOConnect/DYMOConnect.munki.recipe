<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Import DYMO Connect for macOS, preserving separate arm64 and x86_64 pkginfo filenames and Munki name DCDMac.</string>
	<key>Identifier</key>
	<string>com.github.paromacs.munki.DYMOConnect</string>
	<key>ParentRecipe</key>
	<string>com.github.paromacs.download.DYMOConnect</string>
	<key>Input</key>
	<dict>
		<key>NAME</key>
		<string>DYMOConnect</string>
		<key>ARCH</key>
		<string>arm64</string>
		<key>MUNKI_REPO_SUBDIR</key>
		<string>apps/Dymo</string>
		<key>pkginfo</key>
		<dict>
			<key>name</key>
			<string>DCDMac</string>
			<key>display_name</key>
			<string>Dymo Connect for Mac Desktop</string>
			<key>category</key>
			<string>Printers</string>
			<key>developer</key>
			<string>Dymo</string>
			<key>unattended_install</key>
			<true/>
			<key>unattended_uninstall</key>
			<false/>
			<key>autoremove</key>
			<false/>
			<key>uninstallable</key>
			<true/>
			<key>uninstall_method</key>
			<string>removepackages</string>
			<key>installs</key>
			<array>
				<dict>
					<key>path</key>
					<string>/Applications/DYMO Connect.app</string>
					<key>type</key>
					<string>application</string>
					<key>CFBundleIdentifier</key>
					<string>com.dymo.dymo-connect</string>
					<key>CFBundleName</key>
					<string>DYMO Connect</string>
					<key>version_comparison_key</key>
					<string>CFBundleShortVersionString</string>
				</dict>
			</array>
			<key>catalogs</key>
			<array>
				<string>testing</string>
			</array>
		</dict>
	</dict>
	<key>MinimumVersion</key>
	<string>2.7</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Processor</key>
			<string>DYMOMunkiArchPkginfo</string>
			<key>Arguments</key>
			<dict>
				<key>ACTION</key>
				<string>preflight</string>
				<key>repo_subdirectory</key>
				<string>%MUNKI_REPO_SUBDIR%</string>
			</dict>
		</dict>
		<dict>
			<key>Processor</key>
			<string>DYMOPkginfoResolver</string>
		</dict>
		<dict>
			<key>Processor</key>
			<string>MunkiImporter</string>
			<key>Arguments</key>
			<dict>
				<key>pkg_path</key>
				<string>%pathname%</string>
				<key>repo_subdirectory</key>
				<string>%MUNKI_REPO_SUBDIR%</string>
			</dict>
		</dict>
		<dict>
			<key>Processor</key>
			<string>DYMOMunkiArchPkginfo</string>
			<key>Arguments</key>
			<dict>
				<key>ACTION</key>
				<string>finalize</string>
				<key>repo_subdirectory</key>
				<string>%MUNKI_REPO_SUBDIR%</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
