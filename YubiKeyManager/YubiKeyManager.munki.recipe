<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Downloads YubiKey Manager and imports it into Munki.</string>

    <key>Identifier</key>
    <string>com.github.paromacs.YubiKeyManager.munki</string>

    <key>ParentRecipe</key>
    <string>com.github.paromacs.YubiKeyManager.download</string>

    <key>Input</key>
    <dict>
		<key>NAME</key>
		<string>YubiKeyManager</string>
        <key>MUNKI_REPO_SUBDIR</key>
        <string>apps/Yubico</string>
        <key>MUNKI_CATALOG</key>
        <string>testing</string>
		<key>pkginfo</key>
		<dict>
			<key>name</key>
			<string>%NAME%</string>
			<key>display_name</key>
			<string>YubiKey Manager (ykman)</string>
			<key>description</key>
			<string>Yubico command-line tool for configuring and managing YubiKeys.</string>
			<key>catalogs</key>
			<array>
				<string>testing</string>
			</array>
            <key>developer</key>
            <string>Yubico</string>
            <key>category</key>
            <string>Utilities</string>
			<key>supported_architectures</key>
			<array>
				<string>arm64</string>
			</array>
			<key>minimum_os_version</key>
			<string>13.0</string>
			<key>uninstallable</key>
			<true/>
		</dict>
    </dict>

    <key>MinimumVersion</key>
    <string>2.7</string>

    <key>Process</key>
    <array>
        <dict>
            <key>Processor</key>
            <string>MunkiImporter</string>
            <key>Arguments</key>
            <dict>
				<key>pkg_path</key>
				<string>%pathname%</string>
				<key>repo_subdirectory</key>
				<string>%MUNKI_REPO_SUBDIR%</string>
				<key>version_comparison_key</key>
				<string>CFBundleShortVersionString</string>
            </dict>
        </dict>
    </array>
</dict>
</plist>